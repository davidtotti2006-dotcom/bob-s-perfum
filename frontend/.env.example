# ═══════════════════════════════════════════════════════════════
#  Variables d'environnement du front
# ═══════════════════════════════════════════════════════════════
#  Copier en `.env.local` pour le développement.
#  Sur Vercel, définir la variable pour TOUS les environnements
#  concernés (Production ET Preview) : une variable réglée seulement
#  en Production laisse les previews appeler localhost et échouer.
# ═══════════════════════════════════════════════════════════════

# API de production actuelle :
NEXT_PUBLIC_API_URL=https://bobs-perfum-api-git-main-slmmarketci.vercel.app

# En local, avec l'API du dossier ../api lancée sur le port 5000 :
# NEXT_PUBLIC_API_URL=http://localhost:5000
